!pip install music21

from music21 import note # don't forget to import the library here too

# Step 2: Define note value
my_note_value = 60

# Step 3: Create note object
n1 = note.Note(my_note_value)

# Step 4: Play the note
n1.show('midi')

# Step 5: Create a note 1 octave higher
higher_note_value = 72
n2 = note.Note(higher_note_value)
n2.show('midi')
